<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sleepy.recorder.desktop.MainController"
      spacing="10" style="-fx-padding: 10;">

    <!-- Recording controls -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="recordButton" text="Record" onAction="#handleRecord" prefWidth="100"/>
        <Button fx:id="stopButton" text="Stop Recording" onAction="#handleStop" prefWidth="120" disable="true"/>
        <Button fx:id="openButton" text="Open File..." onAction="#handleOpen" prefWidth="100"/>
    </HBox>

    <!-- Progress bar -->
    <ProgressBar fx:id="analysisProgress" prefWidth="Infinity" visible="false"/>

    <!-- Events list -->
    <Label text="Detected Noise Events:" style="-fx-font-weight: bold;"/>
    <ListView fx:id="eventsListView" VBox.vgrow="ALWAYS" prefHeight="400"/>

    <!-- Playback controls -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="playButton" text="Play Event" onAction="#handlePlay" prefWidth="100" disable="true"/>
        <Button fx:id="stopPlayButton" text="Stop Playback" onAction="#handleStopPlay" prefWidth="120" disable="true"/>
    </HBox>

    <!-- Status bar -->
    <Separator/>
    <Label fx:id="statusLabel" text="Ready" style="-fx-font-style: italic;"/>

</VBox>
